# ============================================================
# BidWars - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

NODE_ENV=development
PORT=5000

# Frontend URL (for CORS + OAuth redirects)
FRONTEND_URL=http://127.0.0.1:5500

# Backend URL (for OAuth callbacks)
BACKEND_URL=http://localhost:5000

# ── MongoDB ──────────────────────────────────────────────────
# Get free cluster at: https://mongodb.com/atlas
# Using local MongoDB - Comment out to use Atlas
# MONGODB_URI=mongodb+srv://gandheboyai_db_user:2VILJmy4AqELWTBJ@cluster0.vyadjvk.mongodb.net/bidwars?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/bidwars

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=bidwars_super_secret_jwt_key_change_this_in_production_2024
JWT_EXPIRE=7d
SESSION_SECRET=bidwars_session_secret_change_this_too

# ── Email (Gmail) ─────────────────────────────────────────────
# Use Gmail App Password (NOT your real password)
# Setup: Google Account → Security → 2-Step → App Passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM=your@gmail.com

# ── Stripe Sandbox ───────────────────────────────────────────
# Get keys from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ── PayPal Sandbox ───────────────────────────────────────────
# Get keys from: https://developer.paypal.com/dashboard
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_secret
PAYPAL_MODE=sandbox

# ── Google OAuth (Optional) ──────────────────────────────────
# Get from: https://console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── Facebook OAuth (Optional) ────────────────────────────────
# Get from: https://developers.facebook.com
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# ── Cloudinary (Optional - for image hosting) ────────────────
# Get from: https://cloudinary.com (free tier)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
